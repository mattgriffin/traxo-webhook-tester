{
  "name": "traxo-webhook-tester",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattgriffin/traxo-webhook-tester.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-builder --config electron-builder.config.cjs",
    "build:electron:mac": "vite build && electron-builder --config electron-builder.config.cjs --mac",
    "build:electron:win": "vite build && electron-builder --config electron-builder.config.cjs --win",
    "build:electron:linux": "vite build && electron-builder --config electron-builder.config.cjs --linux",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "lucide-vue-next": "^0.475.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@tailwindcss/vite": "^4.1.7",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5",
    "wait-on": "^8.0.0"
  }
}
